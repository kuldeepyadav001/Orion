# Optional: point Orion at a specific GGUF file instead of auto-discovery.
# ORION_MODEL_PATH=/absolute/path/to/model.gguf

# Log level: error | warn | info | debug | trace
# ORION_LOG=info

# Simulate a different machine for testing tier selection (dev only).
# Shorthand:  T1 | T2 | T3 | T4
# Long form:  ram=32,avail=24,cores=16,vram=12,disk=500   (GiB; ram required)
# ORION_FORCE_PROFILE=T3
